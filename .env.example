# Copy to .env and fill in with your own values. Never commit .env.

# ---------------------------------------------------------------
# App (bundled into the app at build time by Expo)
# ---------------------------------------------------------------

# URL of your PocketBase instance. 127.0.0.1 works for the iOS simulator and the
# Android emulator (rewritten to 10.0.2.2 automatically). On a physical phone,
# use your computer's LAN IP, e.g. http://192.168.1.20:8090, or a public HTTPS URL.
EXPO_PUBLIC_PB_URL=http://127.0.0.1:8090

# Optional: PocketBase superuser fallback used by src/services/pbInit.ts.
# WARNING: EXPO_PUBLIC_* values are bundled into the app binary.
# Leave these empty for anything you distribute.
EXPO_PUBLIC_PB_ADMIN_EMAIL=
EXPO_PUBLIC_PB_ADMIN_PWD=

# Optional: URL that receives app logs as JSON POSTs. Empty = console only.
EXPO_PUBLIC_LOG_ENDPOINT=

# ---------------------------------------------------------------
# Setup scripts only (npm run pb:dev / npm run pb:setup)
# Not prefixed with EXPO_PUBLIC_, so they are never bundled into the app.
# ---------------------------------------------------------------

# PocketBase superuser (dashboard login). pb:dev creates it for you.
PB_SUPERUSER_EMAIL=
PB_SUPERUSER_PASSWORD=
# Defaults to EXPO_PUBLIC_PB_URL if empty
PB_URL=

# SMTP2GO (SMTP user from SMTP2GO > Sending > SMTP Users)
SMTP2GO_USERNAME=
SMTP2GO_PASSWORD=
# Optional overrides
SMTP2GO_HOST=mail.smtp2go.com
SMTP2GO_PORT=2525

# Must be on a domain (or single sender) verified in SMTP2GO
MAIL_SENDER_ADDRESS=
MAIL_SENDER_NAME=SudoZen
# Optional: send a test verification email here after configuring SMTP
SMTP_TEST_TO=
